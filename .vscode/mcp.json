{
  "inputs": [
    {
      "type": "promptString",
      "id": "supabase-access-token",
      "description": "Supabase Personal Access Token (starts with sbp_). Create it at https://supabase.com/dashboard/account/tokens",
      "password": true
    },
    {
      "type": "promptString",
      "id": "resend-api-key",
      "description": "Resend API key (starts with re_). Create it at https://resend.com/api-keys",
      "password": true
    },
    {
      "type": "promptString",
      "id": "render-api-key",
      "description": "Render API key. Create it in your Render dashboard under Account Settings > API Keys",
      "password": true
    }
  ],
  "servers": {
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--project-ref=glznwlevoccqgohpsnjl"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "${input:supabase-access-token}"
      }
    },
    "resend": {
      "type": "http",
      "url": "https://mcp.resend.com/mcp",
      "headers": {
        "Authorization": "Bearer ${input:resend-api-key}"
      }
    },
    "render": {
      "type": "http",
      "url": "https://mcp.render.com/mcp",
      "headers": {
        "Authorization": "Bearer ${input:render-api-key}"
      }
    }
  }
}
