# Local copy of the Render environment. Everything runs on Render in
# production; PORT and RENDER_EXTERNAL_URL are injected by the platform.

# Shared secret for every mutating endpoint (dashboard asks for it once).
# Generate with: openssl rand -hex 32
API_KEY=
# Signs unsubscribe links. Must stay stable across deploys.
# Generate with: openssl rand -hex 32
UNSUBSCRIBE_SECRET=

# Only needed with a custom domain. On Render, RENDER_EXTERNAL_URL is used.
PUBLIC_BASE_URL=

GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_MAPS_MONTHLY_LIMIT=1000
GOOGLE_MAPS_DAILY_LIMIT=50

# Resend email (free tier: 100 emails/day, 3000/month)
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=LeadFlow
EMAIL_REPLY_TO=
CONTACT_PHONE=
EMAIL_DAILY_LIMIT=80
EMAIL_MONTHLY_LIMIT=2500
EMAIL_TEST_REDIRECT=

SUPABASE_URL=https://glznwlevoccqgohpsnjl.supabase.co
# Server-side only. Bypasses RLS — never expose it to a browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# IMAP reply polling
IMAP_HOST=mail-gr.securemail.pro
IMAP_PORT=993
IMAP_TLS=true
IMAP_USER=
IMAP_PASS=

# 24/7 automation (in-process scheduler)
AUTOMATION_ENABLED=true
PIPELINE_INTERVAL_MS=1800000

# Keep-alive self-ping (prevents the free instance from sleeping)
KEEPALIVE_INTERVAL_MS=840000
